{
    "compilerOptions": {
      "target": "ES2020",
      "module": "Node16",
      "moduleResolution": "node16",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "noEmit": true
    },
    "include": [
      "tests/**/*.ts",
      "pages/**/*.ts",
      "playwright.config.ts"
    ]
  }